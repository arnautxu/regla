# ─────────────────────────────────────────────────────────────
# Lilaila — variables de entorno
#
# Copia esto a .env.local para desarrollo, y mételo en Vercel con
# `vercel env add <NOMBRE> production` para el despliegue.
#
# SIN NINGUNA DE ESTAS, la app funciona igual: solo en el móvil,
# sin copia de seguridad y con el banco de frases fijo de Lilita.
# Nada se rompe, simplemente hay menos.
# ─────────────────────────────────────────────────────────────

# --- Copia de seguridad -------------------------------------
# Las tres van juntas: si falta una, no hay puerta ni copia.

# Código que pide la app al abrirse. Mínimo 4 dígitos; usa 6.
LILAILA_PIN=

# Firma las cookies de sesión. Mínimo 16 caracteres.
# Genera uno con:  openssl rand -base64 32
LILAILA_SECRET=

# Almacén del documento de datos (Vercel Blob, privado).
# Se crea en el panel de Vercel: Storage → Create → Blob.
BLOB_READ_WRITE_TOKEN=

# --- Lilita con modelo --------------------------------------
# Sin ninguna de estas, Lilita usa su banco de frases local y el
# chat queda desactivado. Con cualquiera, se enciende.

# OPCION A (recomendada): Gemini directo.
# Se saca gratis en aistudio.google.com/apikey y no depende de la
# facturacion de Vercel.
GOOGLE_GENERATIVE_AI_API_KEY=

# OPCION B: Vercel AI Gateway. En despliegues de Vercel ni siquiera
# hace falta la clave (autentica por OIDC), PERO la cuenta necesita
# una tarjeta para desbloquear los creditos gratuitos.
AI_GATEWAY_API_KEY=

# Opcional: forzar otro modelo sin tocar codigo.
#   con Gemini  -> gemini-3.6-flash, gemini-3.5-flash, gemini-2.5-pro
#   con gateway -> anthropic/claude-sonnet-5
LILAILA_MODEL=

# --- Aviso de la pastilla -----------------------------------
# Sin estas, la pastilla se sigue apuntando a mano; lo unico que
# falta es que el movil suene a las 22:00. Necesita ademas
# BLOB_READ_WRITE_TOKEN (ahi se guardan las suscripciones) y la
# app INSTALADA en la pantalla de inicio: en iOS, Safari a pelo no
# tiene push.
#
# Las claves se generan con:  npm run vapid
# Regenerarlas obliga a volver a activar el aviso desde Ajustes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A quien se queja el servicio de push si algo va mal. Un mailto.
VAPID_SUBJECT=

# Lo pones TU, no Vercel. Es lo que lo enciende: en cuanto existe,
# Vercel manda `Authorization: Bearer <CRON_SECRET>` en cada disparo
# del cron. Sin esta variable, el endpoint contesta 401 siempre y el
# aviso no sale nunca. Genera uno con:  openssl rand -base64 32
# En local sirve para probarlo a mano:
#   curl -H "Authorization: Bearer <el tuyo>" localhost:3000/api/cron/pastilla
CRON_SECRET=

# Zona horaria de ella. Es la que decide que hora es "las 22:00".
# Por defecto Europe/Madrid.
LILAILA_TZ=

# ── Cambiar la hora del aviso ────────────────────────────────
# Hay que tocar DOS sitios, y los dos importan:
#
#   1. `pill.hour` en DEFAULT_SETTINGS (lib/db.ts), que es la hora
#      a partir de la cual el endpoint acepta avisar.
#   2. Los crons de vercel.json, que van en UTC. Los dos que hay
#      —20:00 y 21:00 UTC— son las 22:00 de Madrid en verano y en
#      invierno; para otra hora, restale 2 h en verano y 1 h en
#      invierno y deja las dos entradas.
#
# Con dos entradas diarias cabe en cualquier plan de Vercel. Si el
# plan permite crons por hora, una sola linea `0 * * * *` hace lo
# mismo y deja la hora totalmente libre.
